{
  "name": "godot-mcp",
  "version": "0.1.2",
  "description": "CLI for launching, inspecting, automating, and testing Godot projects.",
  "keywords": [
    "godot",
    "mcp",
    "cli",
    "automation",
    "testing"
  ],
  "homepage": "https://github.com/chanyuenpang/godot-mcp#readme",
  "bugs": {
    "url": "https://github.com/chanyuenpang/godot-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanyuenpang/godot-mcp.git"
  },
  "license": "MIT",
  "author": "Solomon Elias <solomon@sippy.ai>",
  "type": "module",
  "bin": {
    "godot-mcp": "./build/cli.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc && node scripts/build.js",
    "test": "npm run build && node --test build/tests/*.test.js",
    "test:ingame-addon": "npm run build && node scripts/validate-ingame-addon.js",
    "prepare": "npm run build",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "commander": "^14.0.3",
    "fs-extra": "^11.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.13",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
